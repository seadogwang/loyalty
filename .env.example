# Copy to .env and adjust. Never commit real credentials.
DB_URL=jdbc:postgresql://localhost:5432/loyalty
DB_USER=loyalty
DB_PASSWORD=loyalty

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=loyalty-platform

SERVER_PORT=8080

# OIDC / OAuth2 (configure your IdP)
JWT_ISSUER_URI=http://localhost:9000/auth
JWT_AUDIENCE=loyalty-platform

LOG_LEVEL=INFO
