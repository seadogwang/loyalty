<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.loyalty.engine.tier.infrastructure.TierSchemeViewMapper">
    <resultMap id="v" type="com.loyalty.engine.tier.domain.TierSchemeView">
        <constructor>
            <arg column="id" javaType="java.util.UUID"/>
            <arg column="program_id" javaType="java.util.UUID"/>
            <arg column="code" javaType="string"/>
            <arg column="evaluation_period_type" javaType="string"/>
            <arg column="config_json" javaType="string"/>
        </constructor>
    </resultMap>
    <select id="findScoped" resultMap="v">
        SELECT id, program_id, code, evaluation_period_type, config_json::text AS config_json
        FROM loyalty.tier_scheme
        WHERE tenant_id = #{tenantId} AND program_id = #{programId} AND id = #{schemeId}
    </select>
</mapper>
